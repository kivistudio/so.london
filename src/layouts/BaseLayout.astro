---
import '../styles/tokens.css';
import GridOverlay from '../components/GridOverlay.astro';

interface Props {
  title?: string;
  description?: string;
  theme?: 'light' | 'dark';
}

const {
  title = 'Short Obsessions',
  description = 'A place for short, intense fixations. One obsession at a time.',
  theme = 'light',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=DM+Mono:wght@400&display=swap"
    />
  </head>
  <body data-theme={theme}>
    <slot />
    <GridOverlay />
  </body>
</html>
