---
import '../styles/tokens.css';
import GridOverlay from '../components/GridOverlay.astro';
import favicon from '../../assets/logos/favicon.png';
import appleTouchIcon from '../../assets/logos/180x180.png';

interface Props {
  title?: string;
  description?: string;
  theme?: 'light' | 'dark';
}

const {
  title = 'Short Obsessions',
  description = 'A place for short, intense fixations. One obsession at a time.',
  theme = 'light',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />

    <link rel="preconnect" href="https://indestructibletype.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://indestructibletype.com/fonts/Jost.css"
      type="text/css"
      charset="utf-8"
    />
  </head>
  <body data-theme={theme}>
    <slot />
    <GridOverlay />
  </body>
</html>
