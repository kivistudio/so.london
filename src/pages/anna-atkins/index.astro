  font-family: 'DM Mono', monospace;
  font-size: 9.5px;
  letter-spacing: 0.06em;
  opacity: 0;
  transition: opacity 220ms ease;
}
.catalog__photo:hover .attr { opacity: 1; }
.catalog__photo .attr a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; }

.catalog__panel-footer {
  margin-top: 18px;
  display: flex; gap: 24px; flex-wrap: wrap;
  font-family: 'DM Mono', monospace;
  font-size: 9.5px;
