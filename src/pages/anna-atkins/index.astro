<script is:inline>

/* ============================================================
   DATA + RENDER
   ============================================================ */
const $catalog = document.getElementById('catalog');
const $count = document.getElementById('keyCount');

const escapeHtml = (s='') => s
  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
  .replace(/"/g,'&quot;').replace(/'/g,'&#39;');

let PLATES = window.__PLATES__ || [];
let CURRENT_FILTER = 'all';

async function load() {
  if (!PLATES.length) {
    try {
      const res = await fetch('/anna-atkins/plates.json');
      PLATES = await res.json();
    } catch (e) {
      console.error('Could not load plates.json:', e);
      return;
    }
  }
  renderCatalog();
  setupHero();
  setupFilters();
  setupCatalogInteraction();
  setupLightbox();
}

/* ============================================================
   LIGHTBOX — click a card image to view it large
   ============================================================ */
function setupLightbox() {
  const box   = document.getElementById('lightbox');
  const img   = document.getElementById('lightboxImg');
  const cap   = document.getElementById('lightboxCap');
  const close = document.getElementById('lightboxClose');
  if (!box || !img) return;

  const open = (src, alt, captionHtml) => {
    img.classList.remove('loaded');
    img.src = src;
    img.alt = alt || '';
    cap.innerHTML = captionHtml || '';
    img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
    box.showModal();
    document.body.style.overflow = 'hidden';
  };
  const close_ = () => {
    if (box.open) box.close();
    document.body.style.overflow = '';
  };
  close.addEventListener('click', close_);
  img.addEventListener('click', close_);
  // Click on the backdrop (outside .lightbox__figure) closes too
  box.addEventListener('click', (e) => { if (e.target === box) close_(); });
  document.addEventListener('keydown', (e) => {
    if (box.open && e.key === 'Escape') { e.preventDefault(); close_(); }
  });

  // Delegate: clicking the cyanotype thumbnail or modern photo in an
  // expanded catalog panel opens it full-screen. Cyanotypes use the
  // perspective-corrected crop (same file as the panel thumbnail).
  document.getElementById('catalog').addEventListener('click', (e) => {
    const cy = e.target.closest('.catalog__panel-cyano');
    if (cy) {
      const idx = cy.dataset.idx;
      const plate = PLATES.find(p => p.idx === idx);
      if (plate) {
        open('/anna-atkins/book/' + encodeURI(plate.localFile),
             plate.binomial,
             `<em>${escapeHtml(plate.binomial)}</em> · Plate ${plate.idx}`);
      }
      e.stopPropagation();
      return;
    }
    const photo = e.target.closest('.catalog__photo');
    if (photo) {
      const photoImg = photo.querySelector('img');
      if (photoImg && photoImg.src) {
        const idx = photo.dataset.idx;
        const plate = PLATES.find(p => p.idx === idx);
        const credit = photo.querySelector('.attr');
        open(photoImg.src,
             plate ? plate.binomial : '',
             credit ? credit.innerHTML : '');
        e.stopPropagation();
      }
    }
  });
}

function setupHero() {
  setupShelf();
  setupReader();
}

/* ============================================================
   SHELF + FLIP-BOOK READER
   ============================================================ */
const VOLUMES = window.__VOLUMES__ || [];

function setupShelf() {
  const shelf = document.getElementById('shelf');
  if (!shelf || !VOLUMES.length) return;
  shelf.innerHTML = VOLUMES.map((v, i) => `
    <div class="book" data-volume="${i}" tabindex="0" role="button" aria-label="Open ${escapeHtml(v.label)}">
      <div class="book__front">
        <img src="/anna-atkins/book/${encodeURI(v.coverFile)}" alt="${escapeHtml(v.coverTitle)}" />
        <div class="book__plate">
          <div class="roman">${escapeHtml(v.number)}</div>
          <div class="word">Volume</div>
        </div>
      </div>
      <div class="book__caption">
        <strong>${escapeHtml(v.label)}</strong>
        ${escapeHtml(v.dates)} · ${v.pageCount} pages
      </div>
    </div>
  `).join('');
  shelf.querySelectorAll('.book').forEach(el => {
    const open = () => openReader(parseInt(el.dataset.volume, 10));
    el.addEventListener('click', open);
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
  });
}

/* ----- Reader -----
 *
 *  Page indexing matches a real Western book:
 *
 *    rightIdx = 0  →  ∅  | pages[0]       (closed cover — only the recto is visible)
 *    rightIdx = 2  →  pages[1] | pages[2]  (book is open; first true spread)
 *    rightIdx = 4  →  pages[3] | pages[4]
 *    rightIdx = 6  →  pages[5] | pages[6]
 *      ...
 *
 *  Flipping forward advances rightIdx by 2; backward, by −2.  The reader
 *  cannot flip beyond the chosen volume in either direction.
 */
const reader = {
  el:         null,
  volumeIdx:  0,
  pages:      [],
  rightIdx:   0,
  isFlipping: false,
};

function setupReader() {
  reader.el = document.getElementById('reader');
  document.getElementById('readerClose').addEventListener('click', closeReader);
  document.getElementById('btnPrev').addEventListener('click', () => flip('prev'));
  document.getElementById('btnNext').addEventListener('click', () => flip('next'));
  document.getElementById('zonePrev').addEventListener('click', () => flip('prev'));
  document.getElementById('zoneNext').addEventListener('click', () => flip('next'));
  document.getElementById('readerJumpForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const n = parseInt(document.getElementById('readerJump').value, 10);
    if (!Number.isNaN(n)) jumpToRealPage(n);
    document.getElementById('readerJump').blur();
  });
  document.addEventListener('keydown', (e) => {
    if (!reader.el || !reader.el.open) return;
    // Don't intercept arrows while user is typing in the jump input
    const inInput = document.activeElement && document.activeElement.tagName === 'INPUT';
    if (inInput) return;
    if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ')   { e.preventDefault(); flip('next'); }
    if (e.key === 'ArrowLeft'  || e.key === 'PageUp')                       { e.preventDefault(); flip('prev'); }
    if (e.key === 'Escape')                                                 { closeReader(); }
  });
}

function openReader(volIdx) {
  const vol = VOLUMES[volIdx];
  if (!vol) return;
  reader.volumeIdx = volIdx;
  reader.pages = vol.pages;
  reader.realCount = realCount(vol.pages);
  reader.rightIdx = 0;     // start closed: cover visible on the right
  document.getElementById('readerVol').innerHTML = `Volume <em>${escapeHtml(vol.number)}</em> · ${escapeHtml(vol.dates)}`;
  renderSpread();
  reader.el.showModal();
  document.documentElement.classList.add('reader-open');
  // Move focus off the auto-focused jump input so arrow keys / space flip pages immediately.
  requestAnimationFrame(() => {
    const btn = document.getElementById('btnNext');
    if (btn && !btn.disabled) btn.focus({ preventScroll: true });
    else reader.el.focus({ preventScroll: true });
  });
}

// Jump to a specific real-page (1-based count, skipping blanks).
function jumpToRealPage(n) {
  const pages = reader.pages;
  n = Math.max(1, Math.min(reader.realCount, Math.round(n) || 1));
  if (n === 1) { reader.rightIdx = 0; renderSpread(); return; }   // n=1 → cover view
  // Find the virtual index of the n-th RECTO (content page); versos and synthetic blanks don't count.
  let count = 0, virtualIdx = -1;
  for (let i = 0; i < pages.length; i++) {
    if (isRecto(pages[i])) {
      count++;
      if (count === n) { virtualIdx = i; break; }
    }
  }
  if (virtualIdx < 0) return;
  // Snap to a spread: rightIdx must land the recto on the RIGHT side.
  reader.rightIdx = (virtualIdx % 2 === 0) ? virtualIdx : virtualIdx + 1;
  renderSpread();
}

function closeReader() {
  reader.el.close();
  document.documentElement.classList.remove('reader-open');
}

// True if rightIdx represents a state we can actually display
function canShow(r, N) { return (r - 1 >= 0) || (r >= 0 && r < N); }

// True if we can advance past the current state
function canFlipForward(r, N) {
  // Next state is r+2.  Valid if at least one of its two slots holds a real page.
  return (r + 1 < N) || (r + 2 < N);
}

function setPage(imgEl, p) {
  const pageEl = imgEl.closest('.spread__page');
  if (!p) {
    // Off-end (book closed view) — hide the page slot entirely
    imgEl.removeAttribute('src');
    imgEl.alt = '';
    imgEl.style.visibility = 'hidden';
    if (pageEl) { pageEl.classList.add('empty'); pageEl.classList.remove('blank'); }
    return;
  }
  if (p.blank) {
    // Blank verso of a single-sided plate — show as ivory paper, no image
    imgEl.removeAttribute('src');
    imgEl.alt = '';
    imgEl.style.visibility = 'hidden';
    if (pageEl) { pageEl.classList.remove('empty'); pageEl.classList.add('blank'); }
    return;
  }
  // All NYPL scans (rectos + versos) live flat in book/ in book-reading order.
  const path = '/anna-atkins/book/' + p.file;
  imgEl.src = encodeURI(path);
  imgEl.alt = p.title;
  imgEl.style.visibility = 'visible';
  if (pageEl) { pageEl.classList.remove('empty'); pageEl.classList.remove('blank'); }
}

// "Real" = a recto (content page) — neither a synthetic blank nor an extra verso scan.
function isRecto(p) { return p && !p.blank && !p.extra; }
function realCount(pages) {
  return pages.reduce((n, p) => n + (isRecto(p) ? 1 : 0), 0);
}
function realIndexAt(pages, virtualIdx) {
  let n = 0;
  for (let i = 0; i <= virtualIdx && i < pages.length; i++) if (isRecto(pages[i])) n++;
  return n;
}

function renderSpread() {
  const pages = reader.pages;
  const r = reader.rightIdx;
  const l = r - 1;
  const left  = l >= 0 && l < pages.length ? pages[l] : null;
  const right = r >= 0 && r < pages.length ? pages[r] : null;

  const $l = document.getElementById('pageLeft');
  const $r = document.getElementById('pageRight');
  setPage($l, left);
  setPage($r, right);

  // Counter shows the page number of the RECTO in this spread (versos & synthetic blanks don't count).
  const total = reader.realCount;
  let label;
  if (r === 0) {
    label = `cover / ${total}`;
  } else {
    const recto = isRecto(right) ? right : (isRecto(left) ? left : null);
    if (recto) {
      const realIdx = realIndexAt(pages, pages.indexOf(recto));
      label = `${realIdx} / ${total}`;
    } else {
      label = `— / ${total}`;
    }
  }
  document.getElementById('readerCount').textContent = label;

  // Caption: prefer the recto's title
  const captionPage = isRecto(right) ? right : (isRecto(left) ? left : (right || left));
  document.getElementById('readerCaption').textContent = captionPage && captionPage.title ? captionPage.title : '';

  // Page-jump input — keep in sync with the current recto
  const $jump = document.getElementById('readerJump');
  if ($jump && document.activeElement !== $jump) {
    const recto = isRecto(right) ? right : (isRecto(left) ? left : null);
    $jump.value = recto ? realIndexAt(pages, pages.indexOf(recto)) : '';
    $jump.max = total;
  }

  document.getElementById('btnPrev').disabled = (r === 0);
  document.getElementById('btnNext').disabled = !canFlipForward(r, pages.length);
}

function flip(dir) {
  if (reader.isFlipping) return;
  const pages = reader.pages;
  const r = reader.rightIdx;

  if (dir === 'next' && !canFlipForward(r, pages.length)) return;
  if (dir === 'prev' && r === 0) return;

  reader.isFlipping = true;
  const book = document.getElementById('readerBook');
  const flipper = document.createElement('div');
  flipper.className = 'flipper ' + (dir === 'next' ? 'right' : 'left');

  let frontPage, backPage;
  if (dir === 'next') {
    frontPage = pages[r];        // current right page (lifting and turning left)
    backPage  = pages[r + 1];    // back of the lifted page = new left after the flip
  } else {
    frontPage = pages[r - 1];    // current left page (lifting and turning right)
    backPage  = pages[r - 2];    // back of the lifted page = new right after the flip
  }
  const faceHtml = (p) => {
    if (!p) return '';                  // off the end of the volume
    if (p.blank) return '';              // synthetic blank — ivory paper, no image
    const path = '/anna-atkins/book/' + p.file;
    return `<img src="${encodeURI(path)}">`;
  };
  flipper.innerHTML = `
    <div class="flipper__face flipper__face--front ${frontPage && frontPage.blank ? 'blank' : ''}">${faceHtml(frontPage)}</div>
    <div class="flipper__face flipper__face--back  ${backPage  && backPage.blank  ? 'blank' : ''}">${faceHtml(backPage)}</div>
  `;
  book.appendChild(flipper);

  // Pre-load the static page that will be revealed behind the flipper as it
  // rotates past the perpendicular, so the new spread is already in place.
  if (dir === 'next') {
    setPage(document.getElementById('pageRight'), pages[r + 2]);
  } else {
    setPage(document.getElementById('pageLeft'),  pages[r - 3]);
  }

  requestAnimationFrame(() => {
    flipper.classList.add(dir === 'next' ? 'is-flipping-fwd' : 'is-flipping-bwd');
  });

  flipper.addEventListener('animationend', () => {
    reader.rightIdx = r + (dir === 'next' ? 2 : -2);
    flipper.remove();
    renderSpread();
    reader.isFlipping = false;
  }, { once: true });
}

/* ============================================================
   CATALOG — Werner-style table, sections by algal group
   ============================================================ */
// Group order mirrors how Atkins's parts were issued and how Harveyan
// algae books arrange the kingdoms: browns first, reds, greens, then
// the cyanobacteria, diatoms, and lichens at the back.
const GROUP_ORDER = [
  { key: 'brown',  label: 'Brown algæ' },
  { key: 'red',    label: 'Red algæ' },
  { key: 'green',  label: 'Green algæ' },
  { key: 'cyano',  label: 'Cyanobacteria' },
  { key: 'diatom', label: 'Diatoms' },
  { key: 'lichen', label: 'Lichens' },
];

// Tiny abstract range-map placeholder. Same SVG for every row — real range
// data isn't wired up yet, this is the slot Werner gives to "parts" of
// the colour and we'll fill it later.
const MAP_SVG = `
<svg class="catalog__map" viewBox="0 0 60 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect x="1" y="1" width="58" height="34" rx="4" ry="4"
        fill="rgba(15,34,71,0.6)" stroke="rgba(184,139,61,0.45)" stroke-width="0.8" />
  <path d="M8 18 q4 -6 9 -4 q3 1 6 -2 q5 -4 9 1 q4 4 9 1 q3 -2 7 0"
        fill="none" stroke="rgba(219,208,179,0.55)" stroke-width="1" stroke-linecap="round" />
  <circle cx="20" cy="22" r="1.2" fill="rgba(184,139,61,0.7)" />
  <circle cx="38" cy="14" r="1.2" fill="rgba(184,139,61,0.7)" />
</svg>`;

function catalogRow(p) {
  const modern = p.modernName
    ? `<em>${escapeHtml(p.modernName)}</em>`
    : '<span aria-hidden="true">—</span>';
  const modernCls = p.modernName ? '' : ' is-empty';
  const notes = p.notes ? escapeHtml(p.notes) : '';

  return `
    <div class="catalog__row" data-idx="${p.idx}" data-group="${p.group}" role="button" tabindex="0" aria-expanded="false">
      <div class="catalog__cell catalog__cell--thumb">
        <img loading="lazy" decoding="async"
             src="/anna-atkins/book/${encodeURI(p.localFile)}"
             alt="Cyanotype of ${escapeHtml(p.binomial)}"
             onload="this.classList.add('loaded')" />
      </div>
      <div class="catalog__cell catalog__cell--name">
        <span class="plate-no">Pl. ${p.idx}</span><em>${escapeHtml(p.binomial)}</em>
      </div>
      <div class="catalog__cell catalog__cell--modern${modernCls}">${modern}</div>
      <div class="catalog__cell catalog__cell--notes">${notes}</div>
      <div class="catalog__cell catalog__cell--map">${MAP_SVG}</div>
    </div>
    <div class="catalog__panel" data-panel-for="${p.idx}" hidden></div>
  `;
}

function catalogSection(group, plates) {
  const sortedPlates = plates.slice().sort((a, b) => {
    const ag = (a.genus || '').toLowerCase();
    const bg = (b.genus || '').toLowerCase();
    if (ag !== bg) return ag < bg ? -1 : 1;
    const as = (a.species || '').toLowerCase();
    const bs = (b.species || '').toLowerCase();
    if (as !== bs) return as < bs ? -1 : 1;
    return (a.idx || '').localeCompare(b.idx || '');
  });

  const count = sortedPlates.length;
  return `
    <section class="catalog__section" data-group="${group.key}">
      <header class="catalog__section-head">
        <span class="swatch ${group.key}"></span>
        <h2 class="catalog__section-title">${escapeHtml(group.label)}</h2>
        <span class="catalog__section-count">${count} plate${count === 1 ? '' : 's'}</span>
      </header>
      <div class="catalog__head" aria-hidden="true">
        <span class="col-plate">Plate</span>
        <span class="col-name">Anna's name</span>
        <span class="col-modern">Current name</span>
        <span class="col-notes">Notes</span>
        <span class="col-map" style="text-align:right;">Range</span>
      </div>
      ${sortedPlates.map(catalogRow).join('')}
    </section>
  `;
}

function renderCatalog() {
  // Index plates by group key
  const byGroup = {};
  PLATES.forEach(p => {
    if (!byGroup[p.group]) byGroup[p.group] = [];
    byGroup[p.group].push(p);
  });

  const html = GROUP_ORDER
    .filter(g => byGroup[g.key] && byGroup[g.key].length)
    .map(g => catalogSection(g, byGroup[g.key]))
    .join('');

  $catalog.innerHTML = html;
  $count.textContent = PLATES.length + ' plates';
}

/* ----- Filtering ----- */
function setupFilters() {
  document.querySelectorAll('.key__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.key__btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      CURRENT_FILTER = btn.dataset.filter;
      let count = 0;
      document.querySelectorAll('.catalog__section').forEach(sec => {
        const show = CURRENT_FILTER === 'all' || sec.dataset.group === CURRENT_FILTER;
        sec.hidden = !show;
        if (show) count += sec.querySelectorAll('.catalog__row').length;
      });
      $count.textContent = count + ' plate' + (count === 1 ? '' : 's');
    });
  });
}

/* ----- Click-to-expand rows ----- */
function setupCatalogInteraction() {
  $catalog.addEventListener('click', (e) => {
    // Clicks inside an open panel — links, cyanotype thumbnail, modern photo —
    // should not toggle the row. The lightbox delegate handles thumbnail
    // and photo clicks separately.
    if (e.target.closest('.catalog__panel')) return;
    const row = e.target.closest('.catalog__row');
    if (!row) return;
    toggleRow(row);
  });
  $catalog.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const row = e.target.closest('.catalog__row');
    if (!row) return;
    e.preventDefault();
    toggleRow(row);
  });
}

function toggleRow(row) {
  const idx = row.dataset.idx;
  const panel = row.parentElement.querySelector(`.catalog__panel[data-panel-for="${idx}"]`);
  if (!panel) return;
  const open = row.classList.toggle('is-open');
  row.setAttribute('aria-expanded', open ? 'true' : 'false');
  if (open) {
    panel.removeAttribute('hidden');
    panel.classList.add('is-open');
    if (!panel.dataset.populated) {
      panel.innerHTML = panelMarkup(idx);
      panel.dataset.populated = '1';
      const cy = panel.querySelector('.catalog__panel-cyano img');
      if (cy) cy.addEventListener('load', () => cy.classList.add('loaded'), { once: true });
      const photo = panel.querySelector('.catalog__photo');
      if (photo) loadPhoto(photo);
    }
  } else {
    panel.classList.remove('is-open');
    panel.setAttribute('hidden', '');
  }
}

function panelMarkup(idx) {
  const p = PLATES.find(x => x.idx === idx);
  if (!p) return '';
  const notes = p.notes
    ? `<div class="catalog__panel-section">Notes</div><p class="notes">${escapeHtml(p.notes)}</p>` : '';

  return `
    <figure class="catalog__panel-cyano" data-idx="${p.idx}" title="Click to enlarge">
      <img src="/anna-atkins/book/${encodeURI(p.localFile)}" alt="Cyanotype of ${escapeHtml(p.binomial)}" />
    </figure>
    <div class="catalog__panel-body">
      <div class="catalog__panel-section">Habitat</div>
      <p>${escapeHtml(p.habitat)}</p>

      <div class="catalog__panel-section">Where found</div>
      <p class="range">${escapeHtml(p.range)}</p>

      <div class="catalog__panel-section">Transcribed from the plate</div>
      <p class="label">&ldquo;${escapeHtml(p.plateTitle)}&rdquo;</p>

      ${notes}

      <div class="catalog__panel-section">A modern photograph</div>
      <figure class="catalog__photo placeholder"
              data-idx="${p.idx}"
              data-query="${escapeHtml(p.iNatQuery)}">
        <img alt="" />
        <figcaption class="attr"></figcaption>
      </figure>

      <div class="catalog__panel-footer">
        <span>Plate ${escapeHtml(p.idx)} · Vol. ${escapeHtml(p.volume)} · ${escapeHtml(p.groupLabel)}</span>
        <a href="https://digitalcollections.nypl.org/items/${encodeURIComponent(p.captureUUID)}" target="_blank" rel="noopener">N.Y.P.L. plate ↗</a>
        <a href="https://www.inaturalist.org/taxa/search?q=${encodeURIComponent(p.iNatQuery)}" target="_blank" rel="noopener">iNat ↗</a>
      </div>
    </div>
  `;
}

/* ----- iNaturalist photo loading ----- */
// v2: bumped after switching to strict exact-species matching.  The previous
// cache held loose fallbacks (genus / modernName) that we no longer want.
const INAT_CACHE_KEY = 'inat:cache:v2';
const inatCache = (() => {
  try {
    // Drop the old, looser cache so stale fallbacks don't reappear.
    localStorage.removeItem('inat:cache');
    return JSON.parse(localStorage.getItem(INAT_CACHE_KEY) || '{}');
  } catch { return {}; }
})();
const saveCache = () => {
  try { localStorage.setItem(INAT_CACHE_KEY, JSON.stringify(inatCache)); } catch {}
};

// Normalise a binomial for strict comparison: lowercase, single-spaced, no diacritics or extra punctuation.
function normSpecies(s) {
  return (s || '')
    .toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')   // strip diacritics
    .replace(/[^a-z\s-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

async function fetchTaxon(query) {
  if (inatCache[query] !== undefined) return inatCache[query];
  try {
    // Use the /taxa endpoint with rank=species — no fuzzy match, returns species-level hits only.
    const url = `https://api.inaturalist.org/v1/taxa?q=${encodeURIComponent(query)}&rank=species&per_page=5`;
    const res = await fetch(url);
    if (!res.ok) throw new Error('bad status');
    const data = await res.json();
    const qNorm = normSpecies(query);
    // Pick the result whose canonical name matches the query exactly (so different species can't share a photo).
    const t = (data.results || []).find(t => normSpecies(t.name) === qNorm);
    if (!t || !t.default_photo) {
      inatCache[query] = null;
      saveCache();
      return null;
    }
    const photo = t.default_photo;
    const result = {
      url: photo.medium_url || photo.url,
      attribution: photo.attribution || '',
      taxonName: t.name,
      taxonId: t.id,
    };
    inatCache[query] = result;
    saveCache();
    return result;
  } catch (err) {
    inatCache[query] = null;
    saveCache();
    return null;
  }
}

// loadPhoto is invoked when a catalog row is expanded — no
// intersection observer; we only fetch what the reader actually opens.
async function loadPhoto(figure) {
  // Strict match only — different species must not share a photo.  If iNat
  // doesn't have an exact-species photo we leave a labelled placeholder so
  // the gap is visible.
  const query = figure.dataset.query;
  const res = await fetchTaxon(query);
  const img = figure.querySelector('img');
  const cap = figure.querySelector('.attr');
  if (!res) {
    figure.classList.remove('placeholder');
    figure.classList.add('missing');
    return;
  }
  img.src = res.url;
  img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
  cap.innerHTML = `${res.attribution} · <a href="https://www.inaturalist.org/taxa/${res.taxonId}" target="_blank" rel="noopener">${escapeHtml(res.taxonName)}</a> on iNat`;
  figure.classList.remove('placeholder');
}

load();
</script>

