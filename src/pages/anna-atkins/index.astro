}
.catalog__photo.missing {
  background:
    repeating-linear-gradient(135deg,
      rgba(219,208,179,0.06) 0,
      rgba(219,208,179,0.06) 8px,
      transparent 8px,
      transparent 16px),
    rgba(15,34,71,0.5);
  border: 1px dashed rgba(219,208,179,0.18);
}
.catalog__photo.missing::before {
  content: 'no exact-species photograph located';
