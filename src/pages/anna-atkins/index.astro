  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 16px;
  color: var(--cream-dim);
  border-left: 2px solid var(--brass);
  padding-left: 12px;
  margin-top: 6px;
}

.catalog__photo {
  position: relative;
  margin-top: 14px;
  background: rgba(15,34,71,0.5);
  aspect-ratio: 4 / 3;
  overflow: hidden;
}
.catalog__photo img {
  width: 100%; height: 100%; object-fit: cover; display: block;
