<body>

<header class="hero">
  <nav class="hero__menu" aria-label="Primary">
    <a href="#shelf">Volumes</a>
    <a href="#catalog">Catalog</a>
    <a href="#about">About</a>
  </nav>

  <div class="hero__title-block">

    <h1 class="hero__title">
      <span class="line">Photographs</span>
      <span class="line">of British</span>
      <span class="line"><em>Algæ</em></span>
      <span class="line small">Anna Atkins · 1799—1871</span>
    </h1>

    <p class="hero__byline">
      The first book in history to be illustrated by photographs.<br>
      Three hundred and ten <em>cyanotypes</em> printed on paper between 1843 and 1853 by
      <em>Anna Atkins</em> — botanist, photographer, daughter of John George Children —
      working from her home at Halstead Place in Kent.
    </p>

  </div>

  <div class="shelf-wrap">
    <div class="shelf" id="shelf" aria-label="The three volumes — click any book to open it">
      <!-- three book covers injected here -->
    </div>
    <div class="shelf-hint">click a book to leaf through it</div>
  </div>
</header>

<dialog class="reader" id="reader" aria-label="Flip-book reader">
  <div class="reader__wrap">
    <div class="reader__head">
      <div class="vol" id="readerVol">Volume <em>I</em></div>
      <form class="reader__jump-form" id="readerJumpForm">
        <label for="readerJump">go to</label>
        <input type="number" id="readerJump" min="1" placeholder="—" inputmode="numeric" />
        <span class="reader__counter" id="readerCount">— / —</span>
      </form>
      <button class="reader__close" id="readerClose">close ✕</button>
    </div>

    <div class="reader__book" id="readerBook">
      <div class="spread">
        <div class="spread__page left"><img id="pageLeft" alt=""></div>
        <div class="spread__page right"><img id="pageRight" alt=""></div>
      </div>
      <div class="reader__zone prev" id="zonePrev" aria-label="Previous page"></div>
      <div class="reader__zone next" id="zoneNext" aria-label="Next page"></div>
      <!-- flipper injected dynamically -->
    </div>

    <div>
      <p class="reader__caption" id="readerCaption">&nbsp;</p>
      <div class="reader__nav">
        <button id="btnPrev">← previous spread</button>
        <button id="btnNext" autofocus>next spread →</button>
      </div>
