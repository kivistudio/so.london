---
/**
 * "Published on … · Last updated on …" line for an article or page of prose.
 * Dates are ISO strings (YYYY-MM-DD). On a content update, set `updated` to
 * that day's date.
 *
 * Usage:  <PageDates published="2026-09-08" updated="2026-11-28" />
 */
interface Props {
  published: string;
  updated?: string;
}

const { published, updated } = Astro.props;

const format = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<p class="page-dates">
  Published on <time datetime={published}>{format(published)}</time>
  {updated && (
    <>
      {' · '}Last updated on <time datetime={updated}>{format(updated)}</time>
    </>
  )}
</p>

<style>
  .page-dates {
    color: var(--fg-dim);
    font-size: 13px;
    line-height: 1.6;
  }
</style>
