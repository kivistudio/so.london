---
import landingMp4 from '../../assets/video/landing.mp4';
import landingPoster from '../../assets/video/landing-poster.jpg';
---

<div class="bg-video">
  <video
    class="bg-video__el"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={landingPoster.src ?? landingPoster}
  >
    <source src={landingMp4} type="video/mp4" />
  </video>
  <div class="bg-video__veil" aria-hidden="true"></div>
</div>

<style>
  .bg-video {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--bg);
  }

  .bg-video__el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Dim heavy enough that white type reads against any frame of the loop —
     the source is bright daytime grass, so it needs a real overlay, not a
     subtle wash. Strengthen at the top + bottom where the nav and wordmark
     sit, lighter in the middle so the video still leads. */
  .bg-video__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.30) 30%,
        rgba(0, 0, 0, 0.30) 70%,
        rgba(0, 0, 0, 0.65) 100%
      );
    pointer-events: none;
  }

  /* Honour reduced motion: hide the video, show the poster as a static
     background image. */
  @media (prefers-reduced-motion: reduce) {
    .bg-video__el {
      display: none;
    }
    .bg-video {
      background-image: var(--bg-poster);
      background-size: cover;
      background-position: center;
    }
  }
</style>

<script is:inline define:vars={{ poster: landingPoster.src ?? landingPoster }}>
  // The poster URL is hashed by Vite, so we set --bg-poster from JS rather
  // than hardcoding a path in the CSS. Cheap, runs once.
  document.documentElement.style.setProperty('--bg-poster', `url(${poster})`);
</script>
