---
import landingMp4 from '../../assets/video/landing.mp4';
import landingPoster from '../../assets/video/landing-poster.jpg';
---

<div class="bg-video">
  <video
    class="bg-video__el"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={landingPoster.src ?? landingPoster}
  >
    <source src={landingMp4} type="video/mp4" />
  </video>
  <div class="bg-video__veil" aria-hidden="true"></div>
</div>

<!-- Lives outside .bg-video: that container is z-index:-1, so a button inside
     it would sit behind the page and never receive clicks. -->
<button
  type="button"
  class="video-toggle"
  data-video-toggle
  aria-pressed="false"
  aria-label="Pause background video"
>
  <span data-video-label aria-hidden="true">&#10074;&#10074; Pause</span>
</button>

<style>
  .bg-video {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--bg);
  }

  .bg-video__el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Dim heavy enough that white type reads against any frame of the loop —
     the source is bright daytime grass, so it needs a real overlay, not a
     subtle wash. Strengthen at the top + bottom where the nav and wordmark
     sit, lighter in the middle so the video still leads. */
  .bg-video__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.30) 30%,
        rgba(0, 0, 0, 0.30) 70%,
        rgba(0, 0, 0, 0.65) 100%
      );
    pointer-events: none;
  }

  /* Pause/play control for the background video. Deliberately off-grid and
     a touch askew — the landing goes for an unpolished look rather than a
     tidy corner control. */
  .video-toggle {
    position: fixed;
    top: 18%;
    left: 5.5vw;
    z-index: 40;
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--cv-red);
    background: rgba(20, 20, 20, 0.55);
    color: #fff;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    line-height: 1;
    letter-spacing: var(--nav-tracking, 0.22em);
    text-transform: uppercase;
    cursor: pointer;
    transform: rotate(-5deg);
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .video-toggle:hover,
  .video-toggle:focus-visible {
    background: var(--cv-red);
    color: #fff;
  }
  /* Paused state — filled so it reads as "stopped". */
  .video-toggle[aria-pressed='true'] {
    background: var(--cv-red);
    border-color: var(--cv-red);
    color: #fff;
  }

  /* Honour reduced motion: hide the video, show the poster as a static
     background image. */
  @media (prefers-reduced-motion: reduce) {
    .bg-video__el {
      display: none;
    }
    .bg-video {
      background-image: var(--bg-poster);
      background-size: cover;
      background-position: center;
    }
    /* Nothing is moving, so there is nothing to pause. */
    .video-toggle {
      display: none;
    }
  }
</style>

<script is:inline define:vars={{ poster: landingPoster.src ?? landingPoster }}>
  // The poster URL is hashed by Vite, so we set --bg-poster from JS rather
  // than hardcoding a path in the CSS. Cheap, runs once.
  document.documentElement.style.setProperty('--bg-poster', `url(${poster})`);
</script>

<script>
  // Pause/play the looping background video. Mirrors the GridOverlay toggle
  // pattern: aria-pressed reflects state (pressed = paused) and the choice
  // persists in localStorage.
  const STORAGE_KEY = 'so:bg-paused';
  const video  = document.querySelector('.bg-video__el');
  const toggle = document.querySelector('[data-video-toggle]');
  const label  = toggle && toggle.querySelector('[data-video-label]');

  if (video && toggle && label) {
    const apply = (paused) => {
      if (paused) {
        video.pause();
      } else {
        // play() rejects if the browser blocks it (e.g. before interaction);
        // the video is muted+autoplay so this is unlikely, but swallow it.
        video.play().catch(() => {});
      }
      toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
      toggle.setAttribute(
        'aria-label',
        paused ? 'Play background video' : 'Pause background video',
      );
      label.textContent = paused ? '▶ Play' : '❚❚ Pause';
    };

    // Restore previous choice (defaults to playing).
    apply(localStorage.getItem(STORAGE_KEY) === '1');

    toggle.addEventListener('click', () => {
      const next = toggle.getAttribute('aria-pressed') !== 'true';
      apply(next);
      localStorage.setItem(STORAGE_KEY, next ? '1' : '0');
    });
  }
</script>
