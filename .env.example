# The tshirts BUY button stays disabled until this is set (locally, or as the
# GH Actions secret SHOPIFY_DOMAIN, injected as PUBLIC_SHOPIFY_DOMAIN at build).
PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com

# PostHog project API key (EU Cloud). Analytics only load when this is set
# (locally, or as the GH Actions secret POSTHOG_KEY, injected as
# PUBLIC_POSTHOG_KEY at build), so local dev stays untracked by default.
PUBLIC_POSTHOG_KEY=
